# Configurações do Flask
SECRET_KEY=sua-chave-secreta-aqui
FLASK_APP=run.py
FLASK_DEBUG=1

# Banco de Dados
# Se for usar SQLite: sqlite:///db/doce_como_mel.db
# Se for usar PostgreSQL/MySQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///db/doce_como_mel.db

# Provedor de extração de notas fiscais:
#   texto  — usa extrator_nota.py (pdfplumber + regex, sem GPU, padrão para hardware modesto)
#   ollama — usa Ollama + modelo VL (requer GPU ou hardware mais potente)
AI_PROVIDER=texto

# URL da API do backend para o build do APK (ex: https://meu-backend.com)
# No web, se não definido, preserva o comportamento original relativo
API_URL=

# Origens adicionais permitidas pelo CORS separadas por vírgula
# (http://localhost e capacitor://localhost já são aceitos por padrão)
# CORS_ORIGINS=https://meu-dominio.com

# Configurações do Ollama (somente quando AI_PROVIDER=ollama)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-vl:4b-instruct
# OLLAMA_TIMEOUT=180

