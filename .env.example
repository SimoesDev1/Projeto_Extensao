# Configurações do Flask
SECRET_KEY=sua-chave-secreta-super-segura-aqui
FLASK_APP=run.py
FLASK_DEBUG=0

# Cookie de Sessão HTTPS em Produção
# Ativado automaticamente no Render (RENDER=true) ou definindo explicitamente:
# SESSION_COOKIE_SECURE=true

# Banco de Dados
# Desenvolvimento local (padrão se omitido): sqlite:///db/doce_como_mel.db
# Produção no Render (PostgreSQL Externo / Supabase / Neon / Render Postgres):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nomedobanco
# (URIs iniciadas por postgres:// são automaticamente convertidas para postgresql://)
DATABASE_URL=sqlite:///db/doce_como_mel.db

# Provedor de extração de notas fiscais:
#   texto  — usa extrator_nota.py (pdfplumber + regex, sem GPU, ideal para plano free do Render)
#   ollama — usa Ollama + modelo VL (requer GPU ou máquina local)
AI_PROVIDER=texto

# Chave opcional da API Gemini para IA
# GEMINI_API_KEY=

# URL da API do backend para o build do APK (ex: https://meu-app.onrender.com)
# No web, se não definido, preserva o comportamento original com rotas relativas
API_URL=

# Origens adicionais permitidas pelo CORS separadas por vírgula
# (http://localhost e capacitor://localhost já são aceitos por padrão)
# CORS_ORIGINS=https://meu-dominio.com

# Configurações do Ollama (somente quando AI_PROVIDER=ollama)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-vl:4b-instruct
# OLLAMA_TIMEOUT=90
